<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the studio-facing geometry code (chamber, manifolds, Enneper and Scherk engines,
    hyperspace, Escher fields and rooms) together with the engine, against the UnityEngine stand-in
    plus stubs for the studio packages that are not in this repository (Curved World, the control
    rig, the particle swarm). Catches compile breaks across the assembly boundary and runs the
    behaviour tests that need those files:

      dotnet test Tools/CoreTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>CS0649;CS0414;CS0169;CS8632;CS0067</NoWarn>
    <R>$(MSBuildThisFileDirectory)../../Assets</R>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(R)/_GeometryWork/Engine/**/*.cs" Exclude="$(R)/_GeometryWork/Engine/Editor/**/*.cs;$(R)/_GeometryWork/Engine/Tests/**/*.cs" />
    <Compile Include="$(R)/_GeometryWork/Core/ManifoldSurfaces.cs;$(R)/_GeometryWork/Core/CurvedGeometryChamber.cs;$(R)/_GeometryWork/Core/AccordionSettings.cs;$(R)/_GeometryWork/Core/RingFractal.cs;$(R)/_GeometryWork/Core/RingGeometry.cs;$(R)/_GeometryWork/Core/ImplicitSurfaceChamber.cs" />
    <Compile Include="$(R)/_EscherWorldManagement/Hyperspace/Hyper4DField.cs;$(R)/_EscherWorldManagement/Hyperspace/KaleidoFold.cs;$(R)/_EscherWorldManagement/Hyperspace/Hyperspace4DAxis.cs" />
    <Compile Include="$(R)/_EscherWorldManagement/Rooms/EscherFields.cs;$(R)/_EscherWorldManagement/Rooms/EscherRoom.cs;$(R)/_EscherWorldManagement/Rooms/EscherSurfaceBuilder.cs;$(R)/_EscherWorldManagement/Rooms/EscherMarchingTable.cs" />
    <Compile Include="$(R)/_GeometryWork/Shapes/EnneperFoldReality.cs;$(R)/_GeometryWork/Shapes/ScherkTowerEngine.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EngineTests/UnityShim/UnityShim.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
